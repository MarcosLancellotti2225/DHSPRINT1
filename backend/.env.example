# Copiá este archivo como .env y completá los valores.
# Ninguno es obligatorio para desarrollo: todos tienen un valor por defecto.

# Clave con la que se firman los tokens JWT. En producción, cambiala.
JWT_SECRET=clave-de-desarrollo-de-nexthome-cambiar-en-produccion
JWT_EXPIRATION_MINUTES=120

# Administrador que se crea al arrancar si la base está vacía.
ADMIN_EMAIL=admin@nexthome.com
ADMIN_PASSWORD=Admin1234

# Correo de confirmación de reservas.
# En false el correo no se envía: queda escrito en el log de la aplicación.
CORREO_HABILITADO=false
CORREO_DESDE=no-reply@nexthome.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=

# Base de datos PostgreSQL (sólo con el perfil "prod"; en desarrollo se usa H2).
DB_URL=jdbc:postgresql://localhost:5432/nexthome
DB_USER=postgres
DB_PASSWORD=
UPLOADS_DIR=/var/lib/nexthome/uploads
CORS_ORIGINS=http://localhost:5174
